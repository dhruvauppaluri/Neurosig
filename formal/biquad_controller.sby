[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 5
cover: mode cover
cover: depth 16
timeout 900

[engines]
smtbmc bitwuzla

[script]
plugin -i slang
read_slang --std 1800-2017 --single-unit biquad_state.sv biquad_arithmetic_blackbox.sv biquad_controller.sv biquad_controller_formal.sv
hierarchy -top biquad_controller_formal
# read_slang keeps (* anyseq *) as an attribute and drives that net with a
# constant-X buffer. Remove the buffer and attach one $anyseq cell so the
# controller and the assertions sample the same new_y.
select -set anyseq_xbuf a:anyseq %ci t:$buf %i
select -assert-any @anyseq_xbuf
delete @anyseq_xbuf
select -clear
setundef -undriven -anyseq
prep -top biquad_controller_formal

[files]
rtl/biquad_state.sv
formal/biquad_arithmetic_blackbox.sv
rtl/biquad_controller.sv
formal/biquad_controller_formal.sv
